TRANSCRIBER_LANGUAGE=es
TRANSCRIBER_DEBUG=true
TRANSCRIBER_PROVIDER=whisper-local

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=1.5
AUDIO_DEVICE=1
AUDIO_MIN_RMS=50

VAD_AGGRESSIVENESS=1
VAD_SILENCE_FRAMES=35

MAX_SEGMENT_SECONDS=12
OVERLAP_SECONDS=0.4
MIN_SEGMENT_SECONDS=1

WHISPER_MODEL=base
WHISPER_NO_SPEECH_THRESHOLD=0.8
WHISPER_LOG_PROB_THRESHOLD=-0.8
